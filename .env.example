# ==============================================================================
# SnapMedia Server Configuration & Provider Integration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# External Media Provider Integration (Optional)
# If an authorized third-party Instagram media provider is used, configure here:
# ------------------------------------------------------------------------------
# PROVIDER_API_URL=https://api.example.com/v1/instagram/resolve
# PROVIDER_API_KEY=your_authorized_provider_api_key_here

# ------------------------------------------------------------------------------
# Local Extraction Engine Configuration (yt-dlp)
# By default, SnapMedia utilizes the local yt-dlp binary (yt-dlp.exe).
# If Instagram session authentication or rate-limit checkpoints occur,
# place a valid Netscape-format 'cookies.txt' file in the root project directory.
# The server will automatically detect and load it for verified access.
# ------------------------------------------------------------------------------
# COOKIES_PATH=./cookies.txt

# ------------------------------------------------------------------------------
# Rate Limiting Parameters (Requests per minute per client IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_RESOLVE_MAX=60
RATE_LIMIT_DOWNLOAD_MAX=100
